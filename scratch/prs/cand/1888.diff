+    const int64_t chunks_cap = (cap + CH2 - 1) / CH2;
+    int64_t nsp = (2 * (int64_t) sms[dev] + n_q * s.n_head_kv - 1) / (n_q * s.n_head_kv);
+    nsp = std::max<int64_t>(1, std::min<int64_t>({nsp, 20, chunks_cap}));
