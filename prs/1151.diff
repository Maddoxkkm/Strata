 #include <cstring>
+#if defined(__HIPCC__) && defined(STRATA_ROCBLAS_AVAILABLE)
+#define ROCBLAS_BETA_FEATURES_API   // rocblas_gemm_ex_get_solutions: the per-device measurement of the scorer's GEMM
