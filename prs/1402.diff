+            cudaMemcpy(experts_ + e * xblob_, blob.data(), xblob_, cudaMemcpyHostToDevice);
+        }
+        vram_ += bytes;
+    } catch (const std::exception& ex) {
+        err = std::string("mtp: ") + gguf + ": " + ex.what();
+        return false;
+    }
+    return true;
+}
